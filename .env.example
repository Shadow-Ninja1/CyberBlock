# CyberBlock — local/testnet config. NEVER commit this file.
# Fill in your own testnet keys.

ORACLE_PRIVATE_KEY=
ORACLE_ADDRESS=0x37E894935D7fe3d1B52BC6C1BE0Fc18E64478C26
SELLER_PRIVATE_KEY=
SELLER_ADDRESS=0x0588921eaF3Dd55fa72dA9031fc073aA670de8A5
BUYER_PRIVATE_KEY=
BUYER_ADDRESS=0xE3844102585e540a130cBFB8C066E8F7472654db

# The oracle account also deploys the contract.
DEPLOYER_PRIVATE_KEY=

# eth_call traffic (reads, tx submission). A keyed provider like Alchemy is best here.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# eth_getLogs traffic. Must allow wide block ranges (Alchemy free tier caps at 10 blocks).
# Optional — defaults to publicnode when unset.
LOGS_RPC_URL=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_LOGS_RPC_URL=https://base-sepolia-rpc.publicnode.com

# Optional: Etherscan v2 key for contract verification on Basescan
ETHERSCAN_API_KEY=

# Optional: enables the LLM purchase policy in the buyer agent
ANTHROPIC_API_KEY=

# Rules on challenges. A separate key from the oracle on purpose.
ARBITER_PRIVATE_KEY=
ARBITER_ADDRESS=
